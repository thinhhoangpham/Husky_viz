<?xml version="1.0"?>
<!--
  GPS-anchored, obstacle-aware move_base WITH a preloaded static object map.
  Identical to move_base_gps.launch except:
    (1) a map_server node publishes /map from maps/park_map_terrain.yaml, and
    (2) the global costmap is costmap_global_gps_map.yaml (StaticLayer +
        InflationLayer, static_map true, not rolling; no ObstacleLayer).
  The robot, dual-EKF, navsat_transform and TF chain (map->odom->base_link) are
  ASSUMED ALREADY RUNNING (started by load-park-world.sh), same as
  move_base_gps.launch. Absolute config paths per repo convention.

  The map is the TERRAIN-MASKED object map (<world>_map_terrain.yaml), not the
  plain object map: cells the world's DTM has no terrain for (open water,
  off-mesh void) are UNKNOWN in it, plus a 1.0 m eroded margin. Paired with
  track_unknown_space:true (costmap_global_gps_map.yaml) and
  NavfnROS.allow_unknown:false (planner_gps.yaml), the planner refuses to route
  through them. Unknown, NOT lethal - water is a sinking hazard, not a wall.

  Regenerate the masked maps after any DTM or object-map change: see the
  "Terrain mask" section of RUN-MAP-NAV.md for the exact command. (It cannot
  be quoted here: XML forbids a double hyphen inside a comment, and every
  flag it needs starts with one.)

  The map defaults to park; pass map:=<path> for another world, e.g.
    roslaunch launch/move_base_gps_map.launch \
      map:=/home/thinh/Documents/Husky_viz/maps/lake_map_terrain.yaml
  Everything else (planner, costmaps, remaps) is world-independent.
-->
<launch>

  <arg name="map" default="/home/thinh/Documents/Husky_viz/maps/park_map_terrain.yaml"/>

  <node name="map_server" pkg="map_server" type="map_server"
        args="$(arg map)" output="screen"/>

  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">

    <param name="base_global_planner" value="navfn/NavfnROS"/>
    <param name="base_local_planner"  value="dwa_local_planner/DWAPlannerROS"/>

    <rosparam file="/home/thinh/Documents/Husky_viz/config/planner_gps.yaml" command="load"/>

    <rosparam file="/home/thinh/Documents/Husky_viz/config/costmap_common_gps.yaml" command="load" ns="global_costmap"/>
    <rosparam file="/home/thinh/Documents/Husky_viz/config/costmap_common_gps.yaml" command="load" ns="local_costmap"/>

    <rosparam file="/home/thinh/Documents/Husky_viz/config/costmap_local_gps.yaml"      command="load" ns="local_costmap"/>
    <rosparam file="/home/thinh/Documents/Husky_viz/config/costmap_global_gps_map.yaml" command="load" ns="global_costmap"/>

    <remap from="cmd_vel" to="/cmd_vel"/>
    <remap from="odom"    to="/odometry/filtered_map"/>
  </node>

</launch>
